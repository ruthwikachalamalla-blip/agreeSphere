# Render provides PORT for a deployed web service. Use 5000 for local development.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/agrisphere
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
# Required only when running npm run seed; use unique private values.
ADMIN_PASSWORD=
FARMER_PASSWORD=
STORE_PASSWORD=
